{
  "name": "nyrwvy-adapters",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "tools/nyrwvy-mcp"
  ],
  "scripts": {
    "build:host": "node scripts/build-zig-host.mjs",
    "typecheck": "npm run typecheck:adapters && npm run typecheck:bun",
    "typecheck:adapters": "tsc --project tsconfig.adapters.json",
    "typecheck:bun": "tsc --project tsconfig.bun.json",
    "test": "npm run test:adapters && npm run test:node",
    "test:adapters": "node scripts/run-node-tests.mjs fast-adapters",
    "test:node": "node scripts/run-node-tests.mjs fast-contracts fast-mcp",
    "test:node:extended": "node scripts/run-node-tests.mjs extended",
    "test:bun": "bun test ./.opencode/tests/*.test.ts"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@types/node": "22.20.4",
    "bun-types": "1.4.2",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  }
}
