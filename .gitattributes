# Zig embeds tables and sources byte for byte, so every platform checks out LF.
* text=auto eol=lf
# Preserve the exact authenticated compressed offline input bytes on checkout.
examples/offline-session-replay/fixtures/retained-inputs/**/*.gz binary
# The viewer asset carries the hash of its own script, so its bytes must not change on checkout.
src/Nyrwvy.Viewer/viewer.html text eol=lf
