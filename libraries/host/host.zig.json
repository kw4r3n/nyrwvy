{
  "format": "nyrwvy.zig-mapping",
  "version": 1,
  "source": "host.zig",
  "capabilities": {
    "Fs": { "operations": {
      "readText": { "declaration": "readText" },
      "readBytes": { "declaration": "readBytes" },
      "writeBytes": { "declaration": "writeBytes" },
      "rename": { "declaration": "fsRename" },
      "exists": { "declaration": "fsExists" } } },
    "Clock": { "operations": {
      "now": { "declaration": "clockNow" },
      "sleep": { "declaration": "clockSleep" } } },
    "Env": { "operations": {
      "get": { "declaration": "envGet" } } },
    "Process": { "operations": {
      "spawn": { "declaration": "processSpawn" },
      "run": { "declaration": "processRun" } } },
    "Ptys": { "operations": {
      "open": { "declaration": "ptyOpen" },
      "openAt": { "declaration": "ptyOpenAt" },
      "close": { "declaration": "ptyClose", "closes": "pty" } } },
    "Locks": { "operations": {
      "acquire": { "declaration": "lockAcquire" },
      "release": { "declaration": "lockRelease", "closes": "lock" } } },
    "Lock": { "handle": "Lock", "operations": {
      "path": { "declaration": "lockPath" } } },
    "Pty": { "handle": "Pty", "operations": {
      "read": { "declaration": "ptyRead" },
      "write": { "declaration": "ptyWrite" },
      "resize": { "declaration": "ptyResize" },
      "foregroundCommand": { "declaration": "ptyForeground" } } }
  }
}
