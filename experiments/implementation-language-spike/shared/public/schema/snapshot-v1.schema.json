{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nayamnyam implementation-language spike snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "types",
    "functions",
    "calls",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/snapshotId"
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typeEntity"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/functionEntity"
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/callEntity"
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    }
  },
  "$defs": {
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot:[^\\r\\n]+$"
    },
    "typeId": {
      "type": "string",
      "pattern": "^type:[^\\r\\n]+$"
    },
    "functionId": {
      "type": "string",
      "pattern": "^function:[^\\r\\n]+$"
    },
    "parameterId": {
      "type": "string",
      "pattern": "^parameter:[^\\r\\n]+$"
    },
    "callId": {
      "type": "string",
      "pattern": "^call:[^\\r\\n]+$"
    },
    "obligationId": {
      "type": "string",
      "pattern": "^obligation:[^\\r\\n]+$"
    },
    "typeEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/typeId"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/parameterId"
        },
        "name": {
          "type": "string"
        },
        "type_id": {
          "$ref": "#/$defs/typeId"
        }
      }
    },
    "functionEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/functionId"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        }
      }
    },
    "argumentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "value_ref"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/parameterId"
        },
        "value_ref": {
          "type": "string"
        }
      }
    },
    "callEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "callee_id",
        "arguments"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/callId"
        },
        "callee_id": {
          "$ref": "#/$defs/functionId"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argumentBinding"
          }
        }
      }
    },
    "missingArgumentKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "call_id",
        "parameter_id"
      ],
      "properties": {
        "kind": {
          "const": "missing_argument"
        },
        "call_id": {
          "$ref": "#/$defs/callId"
        },
        "parameter_id": {
          "$ref": "#/$defs/parameterId"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/obligationId"
        },
        "kind": {
          "$ref": "#/$defs/missingArgumentKind"
        },
        "status": {
          "const": "open"
        }
      }
    }
  }
}
