    <Compile Include="Domain.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Operations.fs" />
    <Compile Include="CanonicalJson.fs" />
    <Compile Include="Scenarios.fs" />
  </ItemGroup>
</Project>
